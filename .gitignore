### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# vmlinux.h is deliberately tracked, not generated per machine: generating it
# from the builder's /sys/kernel/btf/vmlinux made the build depend on whichever
# kernel happened to be running, and a clean clone did not build at all.

# JetBrains IDE
.idea/
